# ---------------------------------------------------------------------------
# Copy this file to .env and replace the placeholder values.
# NEVER commit the real .env file or real secrets to source control.
# ---------------------------------------------------------------------------

FLASK_APP=run.py
FLASK_DEBUG=True

# Flask session signing key (long random string).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# AES-256-GCM key: URL-safe base64 of exactly 32 random bytes.
# Generate with: flask --app run.py generate-key
FILE_ENCRYPTION_KEY=replace-with-output-of-flask-generate-key

# Cookie security: set to True only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=False

# Maximum upload size in bytes (default: 25 MB).
MAX_CONTENT_LENGTH=26214400

# Optional overrides
# DATABASE_URL=sqlite:///C:/path/to/secure_file_sharing.db
# UPLOAD_FOLDER=C:/path/to/secure_files
